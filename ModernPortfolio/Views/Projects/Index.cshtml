@model List<ModernPortfolio.Models.Project>
@{
    ViewData["Title"] = "Table of Contents";
}

<div class="page-container">
    <h2 class="text-white mb-4">My Projects</h2>
    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="glass-card card h-100">
                    <img src="@p.ThumbnailUrl" class="card-img-top" alt="@p.Title" />
                    <div class="card-body">
                        <h5 class="card-title">@p.Title</h5>
                        <p class="card-text">@p.BriefDescription</p>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-glass">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>