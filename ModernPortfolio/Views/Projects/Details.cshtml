@model ModernPortfolio.Models.Project
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-container">
    <a asp-action="Index" class="text-white-50">&larr; Back to Table of Contents</a>
    <h2 class="text-white mt-3">@Model.Title</h2>
    <img src="@Model.ThumbnailUrl" class="img-fluid mb-3 rounded" style="max-width:400px" />
    <p class="text-white-50">@Model.Description</p>
    <a href="@Model.GithubUrl" target="_blank" class="btn btn-glass-outline">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
        0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
        -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
        .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
        -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27
        .68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12
        .51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48
        0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
        GitHub
    </a>

    <hr class="border-secondary" />
    <h4 class="text-white">Comments</h4>
    <form asp-action="AddComment" asp-controller="Projects" method="post" class="mb-4">
        <input type="hidden" name="projectId" value="@Model.Id" />
        <div class="mb-2">
            <input name="author" class="form-control" placeholder="Your name" />
        </div>
        <div class="mb-2">
            <textarea name="text" class="form-control" placeholder="Write a comment..." required></textarea>
        </div>
        <button type="submit" class="btn btn-glass">Post Comment</button>
    </form>

    @foreach (var c in (List<ModernPortfolio.Models.Comment>)ViewBag.Comments)
    {
        <div class="glass-card p-3 mb-2">
            <strong class="text-white">@c.Author</strong> <small class="text-white-50">@c.CreatedAt.ToString("g")</small>
            <p class="mb-0 text-white-50">@c.Text</p>
        </div>
    }
</div>